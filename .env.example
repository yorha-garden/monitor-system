# Copy to .env.local (never commit it) and fill in. Only the monitor dashboard needs these;
# the landing page runs without any. Read at request time: restart the server after changing.

# --- Dashboard host and Cloudflare Access ---
# The hostname the dashboard is served on. Unset = dashboard disabled everywhere.
DASHBOARD_HOST=monitor.yorhagarden.xyz
# Zero Trust team domain and the Access application's Application Audience (AUD) tag.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=

# --- Cloudflare API (read-only token) ---
# Permissions: Account > Cloudflare Tunnel > Read, and for the yorhagarden.xyz zone
# Zone > Analytics > Read and Zone > DNS > Read (DNS finds tunnels run from a local config.yml).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
# Tunnels routing a hostname under this domain are shown.
MONITOR_DOMAIN=yorhagarden.xyz

# --- Optional ---
# Where uptime checks send requests; {hostname} is replaced per route.
# MONITOR_PROBE_URL_TEMPLATE=https://{hostname}/
# CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
# Local development only (`npm run dev`): skip the Access check. Ignored in production.
# DASHBOARD_DEV_SKIP_ACCESS=1
